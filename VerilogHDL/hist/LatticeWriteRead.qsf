# Quartus II 13.1 project for the Cyclone III experiment-control FPGA.
# The wizard-generated Altera wrappers (fifo/pll _bb/_syn, assignment-defaults
# .qdf) were removed for license compliance; pll.v documents the ALTPLL
# parameters to regenerate them with the Quartus megafunction wizard.

set_global_assignment -name FAMILY "Cyclone III"
set_global_assignment -name DEVICE EP3C25Q240C8
set_global_assignment -name TOP_LEVEL_ENTITY LatticeWriteRead
set_global_assignment -name ORIGINAL_QUARTUS_VERSION "13.0 SP1"
set_global_assignment -name LAST_QUARTUS_VERSION "13.0 SP1"
set_global_assignment -name PROJECT_OUTPUT_DIRECTORY output_files
set_global_assignment -name MIN_CORE_JUNCTION_TEMP 0
set_global_assignment -name MAX_CORE_JUNCTION_TEMP 85
set_global_assignment -name ERROR_CHECK_FREQUENCY_DIVISOR 1
set_global_assignment -name NOMINAL_CORE_SUPPLY_VOLTAGE 1.2V
set_global_assignment -name STRATIX_DEVICE_IO_STANDARD "2.5 V"

set_global_assignment -name VERILOG_FILE main.v
set_global_assignment -name VERILOG_FILE pll.v
set_global_assignment -name VERILOG_FILE HISTGRAM.v
set_global_assignment -name VERILOG_FILE InputChannel.v
set_global_assignment -name VERILOG_FILE AWGControl.v
set_global_assignment -name VERILOG_FILE uart_rx.v
set_global_assignment -name VERILOG_FILE uart_tx.v
set_global_assignment -name SDC_FILE LatticeWriteRead.sdc

set_location_assignment PIN_107 -to in[0]
set_location_assignment PIN_106 -to in[1]
set_location_assignment PIN_99 -to Write
set_location_assignment PIN_98 -to Read
set_location_assignment PIN_95 -to PumpingW
set_location_assignment PIN_87 -to PumpingR
set_location_assignment PIN_103 -to triggerall
set_location_assignment PIN_31 -to sys_clk
set_location_assignment PIN_45 -to uart_tx
set_location_assignment PIN_46 -to uart_rx
set_location_assignment PIN_49 -to rst_n

set_instance_assignment -name PARTITION_HIERARCHY root_partition -to | -section_id Top
set_global_assignment -name PARTITION_NETLIST_TYPE SOURCE -section_id Top
set_global_assignment -name PARTITION_FITTER_PRESERVATION_LEVEL PLACEMENT_AND_ROUTING -section_id Top
set_global_assignment -name PARTITION_COLOR 16764057 -section_id Top
