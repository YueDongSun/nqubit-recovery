*.py[cod]
.venv/
venv/

# Keep project inputs trackable:
#   *.qpf, *.qsf, *.qdf, *.qip, *.ppf
#   *.v, *.sv, *.vhd, *.bdf, *.sdc, *.mif, *.hex
#   *.py, requirements.txt
